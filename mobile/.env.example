# Leave these unset to stay in demo mode in Expo Go.
# On a phone talking to a computer, use the computer's Wi-Fi address, not localhost.
# Restart Expo after changing this file. You can also set the server address in the app.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8787

# For an installed APK, set these in the Expo "preview" environment before building.
# They are baked into the app. They are not the Gemini key, and never the Supabase secret key.
# EXPO_PUBLIC_API_URL=https://your-project.vercel.app
# EXPO_PUBLIC_APP_SECRET=only-if-you-set-APP_SECRET
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=the-publishable-or-anon-key
