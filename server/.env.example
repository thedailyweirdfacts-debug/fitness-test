# Copy this file to server/.env. Never commit the real file.
# The phone app does not get the Gemini key or the Supabase secret key.

# gemini (default, free), openai, or anthropic
VISION_PROVIDER=gemini

# Key for the provider above.
# Gemini: a free key from https://aistudio.google.com/apikey (no credit card).
# You can also set GEMINI_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY.
VISION_API_KEY=

# Optional extra password. Leave it blank and a signed-in account is enough.
# If you set it, the app must send the same value.
# APP_SECRET=

# Supabase project. Estimates are refused until these three are set.
# URL and the publishable (anon) key are safe in the app. The secret (service_role) key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free scans per signed-in person per Pacific day. Two people at 10 stays near the free Gemini cap of about 20.
# SCAN_DAILY_CAP=10

# Optional. Defaults: gemini-3.8-flash, gpt-5.4-mini, claude-haiku-5-5.
# Flash-Lite allows more free requests per day: VISION_MODEL=gemini-3.5-flash-lite
# VISION_MODEL=gemini-3.8-flash

# Optional. When Gemini 3.8 Flash is busy, retry it once, then try these in order.
# Defaults: gemini-3.6-flash, gemini-3.5-flash-lite. Set empty to disable.
# VISION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional extra brake, per address, on top of the per-person cap. Defaults: 5 per minute, 60 per day.
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=60

PORT=8787
