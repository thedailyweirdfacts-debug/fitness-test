# Copy this file to server/.env. Never commit the real file.
# The phone app does not get this key. Only this server reads it.

# openai or anthropic
VISION_PROVIDER=openai

# Key for the provider above. You can also set OPENAI_API_KEY or ANTHROPIC_API_KEY instead.
VISION_API_KEY=

# Optional. Defaults: gpt-5.4-mini (OpenAI), claude-haiku-5-5 (Anthropic).
# VISION_MODEL=gpt-5.4-mini

PORT=8787
